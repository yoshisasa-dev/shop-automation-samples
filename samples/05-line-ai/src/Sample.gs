 */

var SAMPLE_FAQS = [
  ['営業', '営業時間は？', '10:00〜19:00です（最終受付はメニューにより異なります）。', true],
  ['営業', '定休日はいつ？', '毎週火曜日がお休みです。', true],
  ['料金', 'カットはいくら？', 'カットは4,950円です。前髪カットだけなら1,100円です。', true],
  ['料金', 'カラーの料金は？', 'カット＋カラーで11,000円です。', true],
  ['料金', 'パーマの料金は？', 'パーマは12,100円です。', true],
  ['料金', 'ヘッドスパはありますか？', 'あります。30分3,300円です。', true],
  ['予約', '予約はどうやってするの？', 'ネットの予約ページから24時間ご予約いただけます。お電話でも営業時間内に受け付けています。', true],
  ['予約', 'キャンセルの決まりは？', '前日の18時までにご連絡ください。当日のキャンセルは、次回のご予約のときにご相談させてください。', true],
  ['お店', '駐車場はありますか？', 'お店の裏に2台分あります。満車のときは近くのコインパーキングをご利用ください。', true],
  ['お店', '支払い方法は？', '現金・クレジットカード・交通系IC・QRコード決済がご利用いただけます。', true],
  ['お店', '子ども連れでも大丈夫？', 'はい、大丈夫です。ベビーカーのまま入れます。ご予約のときに一言お知らせください。', true],
  ['スタッフ', 'スタッフの指名はできますか？', 'はい、ご予約のときにご指名いただけます。指名料はかかりません。', true]
];

/** よくある質問をサンプルの内容で入れ直す */
function insertSampleFaqs() {
  assertOwner_();
  var sheet = ensureSheet_(SHEET_FAQ, FAQ_HEADERS);
  if (sheet.getLastRow() > 1) sheet.getRange(2, 1, sheet.getLastRow() - 1, 4).clearContent();
  sheet.getRange(2, 1, SAMPLE_FAQS.length, 4).setValues(SAMPLE_FAQS);
  log_('情報', 'サンプルの「よくある質問」を入れました（' + SAMPLE_FAQS.length + '件）');
}
