{
  "name": "受け取り日時",
  "settings": [
    {
      "type": "paragraph",
      "content": "カートで、ケーキの受け取り日と時間を選んでもらいます。選んだ日時は注文に「受け取り日」「受け取り時間」として残ります。"
    },
    {
      "type": "checkbox",
      "id": "pickup_enabled",
      "label": "カートで受け取り日時を選んでもらう",
      "default": true
    },
    {
      "type": "range",
      "id": "pickup_lead_days",
      "label": "何日後から予約できるか",
      "min": 0,
      "max": 14,
      "step": 1,
      "unit": "日",
      "default": 3
    },
    {
      "type": "range",
      "id": "pickup_max_days",
      "label": "何日先まで予約できるか",
      "min": 7,
      "max": 90,
      "step": 1,
      "unit": "日",
      "default": 30
    },
    {
      "type": "text",
      "id": "pickup_closed_days",
      "label": "定休日（曜日。複数ならカンマ区切り）",
