    },
    {
      "type": "text",
      "id": "pickup_time_slots",
      "label": "受け取り時間（カンマ区切り）",
      "default": "11:00,12:00,13:00,14:00,15:00,16:00,17:00,18:00"
    },
    {
      "type": "text",
      "id": "pickup_note",
      "label": "説明文",
      "default": "ケーキは3日後から予約できます。火曜日は定休日です。"
    }
  ]
